<Window x:Class="ClickerGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClickerGame"
        mc:Ignorable="d"
        Title="Clicker Game"
        Height="450"
        Width="800"
        MinHeight="350"
        MinWidth="600">

    <Window.Resources>
        <Style x:Key="ClickerButtonStyle"
               TargetType="Button">

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- Clicker Area -->
        <Button Content="Click"
                Click="Clicker_Area"
                Background="White"
                BorderBrush="{x:Null}"
                Focusable="False"
                Style="{StaticResource ClickerButtonStyle}"/>

        <!-- Currency -->
        <Border 
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,20,0,0"
        Padding="20,8"
        Width="150"
        Background="White"
        BorderBrush="Black"
        BorderThickness="0.5"
        CornerRadius="10">

            <TextBlock x:Name="TotalClicks"
               Text="Start Clicking"
               FontSize="19"
               FontWeight="Normal"
               TextAlignment="Center"
               IsHitTestVisible="False"/>

        </Border>

        <!-- Powerups and Upgrades -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="180"
                    Margin="0,0,20,0">

            <Button Content="Powerup Speed"
                    Height="50"
                    Margin="0,0,0,20"
                    Focusable="False"
                    Click="Powerup_Speed"/>

            <Button Content="Powerup Double Click"
                    Height="50"
                    Margin="0,0,0,20"
                    Focusable="False"
                    Click="Powerup_DoubleClick"/>

            <Button Content="Upgrade AutoClick"
                    Height="50"
                    Margin="0,0,0,20"
                    Focusable="False"
                    Click="Upgrade_AutoClick"/>

            <Button Content="Upgrade IncreaseClick"
                    Height="50"
                    Focusable="False"
                    Click="Upgrade_IncreaseClick"/>

        </StackPanel>
        <Image HorizontalAlignment="Left" Height="21" Margin="475,62,0,0" VerticalAlignment="Top" Source="/cursor-png-1113.png" Width="15"/>

    </Grid>

</Window>