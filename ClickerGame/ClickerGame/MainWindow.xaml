<Window x:Class="ClickerGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClickerGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Click" HorizontalAlignment="Center" Margin="0,112,0,122" Width="200" Height="200" RenderTransformOrigin="0.6,1.791" Click="Clicker_Button"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="695,54,0,0" VerticalAlignment="Top" Height="50" Click="Powerup_Speed"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="695,112,0,0" VerticalAlignment="Top" Height="50" Click="Powerup_DoubleClick"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="695,187,0,0" VerticalAlignment="Top" Height="50" Click="Upgrade_AutoClick"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="695,242,0,0" VerticalAlignment="Top" Height="50" Click="Upgrade_IncreaseClick" x:Name="UpgradeClickButton"/>
        <TextBlock x:Name="TotalClickText" TextWrapping="Wrap" Text="TextBlock" Margin="300,30,300,355"/>
        <Canvas x:Name="MovingTextCanvas" Width="200" Height="150" IsHitTestVisible="False"/>
        

    </Grid>
</Window>
